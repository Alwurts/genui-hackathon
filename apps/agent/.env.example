# ----------------------------------------------------------------------------
# genui-hackathon / apps/agent/.env — read by `langgraph dev` from this dir.
# Mirrors the keys the agent itself reads at runtime.
# Quickest setup: `cp ../../.env ./.env` after editing the root .env.
#
# See ../../docs/setup.md for the full key story.
# ----------------------------------------------------------------------------

# Gemini API key — chat orchestration + Gemini 3 Pro Preview scoring.
# Get a key: https://aistudio.google.com → Get API key (starts with AIza).
GEMINI_API_KEY=stub-replace-with-real-key-from-aistudio-google-com

# Agent runtime selector.
# Options: gemini-flash-deep | gemini-flash-react | claude-sonnet-4-6-react
AGENT_RUNTIME=gemini-flash-deep

# GitHub PAT — OPTIONAL. Public reads work anonymously; a PAT raises rate
# limit (60→5000/hr) and is required for v1.4 write actions (post comment,
# approve, request_changes). Fine-grained PAT recommended:
# Contents: Read, Pull requests: Read+Write.
GITHUB_PAT=

# Demo PR override — set to `cached://demo` to force the cached fallback PR.
GITHUB_DEMO_PR=cached://demo

# Anthropic key — only if you flip the runtime or scoring to Claude.
# ANTHROPIC_API_KEY=

# === Legacy: Notion (will be removed when the GitHub swap lands in v1.3) ====
NOTION_TOKEN=ntn_TEMP000000000000000000000000000000000000000000
NOTION_LEADS_DATABASE_ID=00000000000000000000000000000000

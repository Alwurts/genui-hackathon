# ----------------------------------------------------------------------------
# genui-hackathon — root env
#
# Copy:  cp .env.example .env  &&  cp .env apps/agent/.env
# Both files are required (Next.js + BFF read root .env;
# `langgraph dev` reads apps/agent/.env from the agent's working directory).
#
# See docs/setup.md for what each key is, where to get it, and which build
# phase requires it. v1.0 / v1.1 (cached demo PR + lens switching) needs
# nothing; v1.3 (real agent + scoring) needs only GEMINI_API_KEY;
# v1.4 (real comment posting) adds GITHUB_PAT.
# ----------------------------------------------------------------------------

# === Required for v1.3+ =====================================================

# Gemini API key — chat orchestration (Flash-Lite) AND per-hunk scoring
# (Gemini 3 Pro Preview, called from apps/agent/src/scoring.py).
# Get a key: https://aistudio.google.com → Get API key (starts with AIza).
GEMINI_API_KEY=stub-replace-with-real-key-from-aistudio-google-com

# === Optional / cosmetic ====================================================

# GitHub PAT — OPTIONAL until v1.4 (the comment-posting beat). Public-PR
# reads work anonymously (60 req/hr per IP); a PAT bumps that to 5000/hr
# AND enables write actions (post comment, approve, request_changes).
# Recommended: fine-grained PAT scoped to one repo with
# Contents: Read and Pull requests: Read+Write. Classic alternative: `repo`
# (or `public_repo` for read-only).
GITHUB_PAT=

# CopilotKit license — silences the "1 Issue" badge and enables durable
# threads. Run `npx @copilotkit/cli@latest init` to obtain.
COPILOTKIT_LICENSE_TOKEN=

# Anthropic key — only if you flip apps/agent/src/runtime.py or scoring.py
# to a Claude backend (e.g. as a Gemini fallback on event day).
# ANTHROPIC_API_KEY=

# Demo PR override. Set to `cached://demo` to force the canvas to use the
# hand-crafted fallback PR even when GITHUB_PAT is set. Leave blank to use
# the live-paste path once it lands in v1.5c.
GITHUB_DEMO_PR=cached://demo

# === Agent runtime ==========================================================
# Options: gemini-flash-deep | gemini-flash-react | claude-sonnet-4-6-react
AGENT_RUNTIME=gemini-flash-deep

# === Intelligence (durable threads) =========================================
INTELLIGENCE_API_URL=http://localhost:4203
INTELLIGENCE_GATEWAY_WS_URL=ws://localhost:4403
INTELLIGENCE_API_KEY=cpk_sPRVSEED_seed0privat0longtoken00

POSTGRES_HOST_PORT=5433
REDIS_HOST_PORT=6381
APP_API_HOST_PORT=4203
REALTIME_GATEWAY_HOST_PORT=4403

# === Service URLs ===========================================================
# `npm run dev:agent` binds the LangGraph deep-agent to 8133.
LANGGRAPH_DEPLOYMENT_URL=http://localhost:8133

# `npm run dev:mcp` binds the Manufact (mcp-use) server to 3011.
MCP_SERVER_URL=http://localhost:3011/mcp

# CopilotKit BFF (Hono runtime). Override only if you move it off :4000.
# BFF_URL=http://localhost:4000

# === Legacy: Notion (will be removed in v1.3 when GitHub swap lands) ========
# Kept so the upstream `predev` Notion health check doesn't error out before
# we replace it. After v1.3 these can be deleted along with the agent's
# notion_* modules.
NOTION_TOKEN=ntn_TEMP000000000000000000000000000000000000000000
NOTION_LEADS_DATABASE_ID=00000000000000000000000000000000

# Optional thread culler tuning
THREAD_STALE_HOURS=3
THREAD_CULL_BATCH_SIZE=1000
